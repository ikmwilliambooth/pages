# Salin ke .env dan isi dengan nilai dari project Supabase Anda.
# Dapatkan di Project Settings > API (service_role key bersifat rahasia; jangan publikasikan).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role-key-with-full-access
# Asal publik situs (opsional). Jika diawali https://, cookie sesi ditandai Secure.
PUBLIC_ORIGIN=https://ikm.example.org
# Port/host server Node.js.
PORT=3000
HOST=0.0.0.0
